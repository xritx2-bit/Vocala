# Discord Bot Configuration
# Get your bot token from: https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Your Discord Application (Client) ID
CLIENT_ID=your_client_id_here

# Default Neural Voice (Hindi / Indian English / English)
# Options:
#   hi-IN-MadhurNeural   (Hindi Male - Great for Hindi & Hinglish)
#   hi-IN-SwaraNeural    (Hindi Female - Clear & Natural)
#   en-IN-PrabhatNeural  (Indian English Male)
#   en-IN-NeerjaNeural   (Indian English Female)
#   en-US-JennyNeural    (US English Female)
#   en-US-GuyNeural      (US English Male)
DEFAULT_VOICE=hi-IN-MadhurNeural

# Default announcement mode:
# 'hinglish' => "Rahul ne kaha: [message]"
# 'english'  => "Rahul says: [message]"
# 'name_only'=> "Rahul: [message]"
# 'direct'   => "[message]"
DEFAULT_MODE=hinglish

# Max characters per message to speak (avoids voice spam)
MAX_MESSAGE_LENGTH=300
